---
import { Image } from 'astro:assets';
import { businessInfo } from '../data/businessInfo';
import heroImg from '../assets/pulpeira-cortando-pulpo.webp';
---

<section id="inicio" class="relative bg-slate-dark text-white pt-28 sm:pt-36 overflow-hidden">
  
  <!-- Subtle ambient gold glow behind headline -->
  <div class="absolute top-1/4 left-10 w-96 h-96 bg-gold/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-16 sm:py-24 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Title & Presentation -->
      <div class="lg:col-span-7 flex flex-col justify-center text-center lg:text-left">
        
        <!-- Subtítulo pequeño en oro -->
        <div class="inline-flex items-center justify-center lg:justify-start gap-3 text-xs uppercase tracking-[0.35em] font-bold text-gold mb-6 font-sans">
          <span class="w-8 h-px bg-gold"></span>
          <span>Pulpería Ambulante Tradicional</span>
        </div>

        <!-- Gran titular serif en blanco / oro -->
        <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.1] mb-8 text-white uppercase">
          Tradición Gallega, <br />
          <span class="text-gold font-normal italic font-cursive lowercase first-letter:uppercase">
            sabor que une
          </span>
        </h1>

        <!-- Breve texto descriptivo -->
        <p class="font-sans text-base sm:text-lg text-slate-muted font-light leading-relaxed max-w-xl mx-auto lg:mx-0 mb-10">
          Elaboramos el auténtico pulpo á feira en directo sobre platos tradicionales de madera. Llevamos el sabor y el ambiente festivo de Galicia a cualquier punto donde celebres tu evento.
        </p>

        <!-- Botón dorado "PEDIR PRESUPUESTO" -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-5">
          <a 
            href={`https://wa.me/${businessInfo.phoneClean}?text=${encodeURIComponent(businessInfo.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3.5 px-9 sm:px-11 py-4 sm:py-5 bg-gold hover:bg-gold-hover text-slate-950 rounded-full font-bold text-sm uppercase tracking-[0.16em] transition-all duration-300 shadow-gold-glow hover:scale-105 active:scale-95 font-sans"
          >
            <span>Pedir Presupuesto</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>

          <span class="text-xs uppercase tracking-widest text-slate-muted font-sans font-medium">
            Atención telefónica · {businessInfo.phone}
          </span>
        </div>

      </div>

      <!-- Right Column: Fotografía destacada del plato de madera tradicional con pulpo -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-md">
          
          <!-- Aro decorativo dorado exterior -->
          <div class="absolute -inset-4 rounded-full border border-gold/30 scale-95 pointer-events-none animate-pulse"></div>

          <!-- Contenedor circular con imagen del pulpo recién cortado -->
          <div class="relative aspect-square rounded-full overflow-hidden border-2 border-gold shadow-dark-luxury bg-slate-card group">
            <Image 
              src={heroImg} 
              alt="Plato tradicional de madera con pulpo recién cortado y pimentón" 
              class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-108"
              width={700}
              height={700}
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent"></div>
          </div>

          <!-- Insignia flotante tradicional -->
          <div class="absolute -bottom-4 right-4 bg-slate-card/95 backdrop-blur-md px-5 py-3 rounded-2xl border border-gold/40 shadow-xl flex items-center gap-3 text-left">
            <div class="w-10 h-10 rounded-full bg-gold/15 border border-gold/50 flex items-center justify-center text-gold font-serif font-bold text-xs">
              50+
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-widest text-gold font-bold">Corte a tijera</p>
              <p class="font-serif text-xs font-bold text-white">Sobre madera</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Separador SVG en forma de curva suave hacia el fondo crema #FBF8F2 -->
  <div class="relative w-full leading-none overflow-hidden">
    <svg 
      class="w-full h-14 sm:h-20 lg:h-28 text-cream block" 
      viewBox="0 0 1440 120" 
      fill="none" 
      preserveAspectRatio="none"
    >
      <path 
        d="M0,32 C240,96 480,120 720,120 C960,120 1200,96 1440,32 L1440,120 L0,120 Z" 
        fill="currentColor"
      />
    </svg>
  </div>

</section>
