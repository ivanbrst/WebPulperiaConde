---
import { Image } from 'astro:assets';
import { businessInfo } from '../data/businessInfo';
import heroImg from '../assets/pulperia-Carballino-1024x1024.webp';
---

<section class="min-h-[calc(100vh-8rem)] flex flex-col justify-center bg-linen border-b border-linen-300 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 w-full py-12 lg:py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Giant Editorial Typography & Heritage Quote -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        
        <!-- Overline Tag -->
        <div class="inline-flex items-center gap-3 text-xs uppercase tracking-[0.3em] font-bold text-purple-brand mb-6 font-sans">
          <span class="w-2.5 h-2.5 rounded-full bg-purple-brand"></span>
          Más de 50 años de tradición familiar
        </div>

        <!-- Colossal Headline in Cinzel -->
        <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-bold text-anthracite tracking-tight leading-[1.08] mb-8">
          El Sabor del Oficio. <br />
          <span class="font-normal italic font-serif text-anthracite-700">
            Pulpo á Feira para Eventos en Directo.
          </span>
        </h1>

        <!-- MANDATORY HERITAGE QUOTE -->
        <div class="border-l-4 border-purple-brand pl-6 py-2 mb-10 bg-purple-soft/40 rounded-r-2xl">
          <p class="font-serif italic text-lg sm:text-xl text-anthracite-900 leading-relaxed">
            "{businessInfo.historyQuote}"
          </p>
        </div>

        <!-- CTA Action Area -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 pt-2">
          <a 
            href={`https://wa.me/${businessInfo.phoneClean}?text=${encodeURIComponent(businessInfo.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3.5 px-8 sm:px-10 py-4 sm:py-5 bg-purple-brand hover:bg-purple-hover text-white rounded-full font-bold text-sm sm:text-base uppercase tracking-[0.12em] transition-all duration-300 shadow-lg hover:shadow-purple-glow hover:-translate-y-0.5 active:translate-y-0 font-sans"
          >
            <svg class="w-5 h-5 fill-current flex-shrink-0" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>Pedir Presupuesto por WhatsApp</span>
          </a>

          <a 
            href={`tel:${businessInfo.phoneClean}`}
            class="inline-flex items-center justify-center gap-2 py-3 px-4 rounded-full text-sm font-semibold text-anthracite-700 hover:text-purple-brand transition-colors font-sans"
          >
            <svg class="w-4 h-4 text-purple-brand flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <span class="whitespace-nowrap">Teléfono: {businessInfo.phone}</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Full-Bleed Authentic Visual -->
      <div class="lg:col-span-5 h-full flex items-center">
        <div class="relative w-full rounded-3xl overflow-hidden shadow-2xl border border-linen-300 bg-anthracite group">
          <Image 
            src={heroImg} 
            alt="Puesto tradicional de Pulpería Conde para eventos" 
            class="w-full aspect-[4/5] object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            width={720}
            height={900}
            loading="eager"
          />

          <!-- Authentic Stamp -->
          <div class="absolute bottom-6 left-6 right-6 bg-anthracite-950/90 backdrop-blur-md p-5 rounded-2xl border border-anthracite-700 text-linen-100 flex items-center justify-between">
            <div>
              <p class="text-xs uppercase tracking-[0.2em] text-purple-light font-bold">Tradición Pulpeira</p>
              <p class="font-serif text-lg font-bold text-white">Elaboración en Directo</p>
            </div>
            <div class="w-12 h-12 rounded-full border-2 border-purple-light flex items-center justify-center text-purple-light font-serif font-bold text-xs text-center">
              50+<br/>años
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
