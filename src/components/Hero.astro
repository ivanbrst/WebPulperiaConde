---
import { Image } from 'astro:assets';
import { businessInfo } from '../data/businessInfo';
import heroImg from '../assets/pulpeira-cortando-pulpo.webp';
---

<section id="inicio" class="relative min-h-screen bg-linen flex flex-col overflow-hidden">

  <!-- Background texture gradient -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 right-0 w-2/3 h-full bg-gradient-to-l from-linen-warm to-transparent"></div>
    <div class="absolute -bottom-32 -left-32 w-[600px] h-[600px] rounded-full bg-purple-subtle/60 blur-[120px]"></div>
    <div class="absolute top-1/4 right-0 w-[400px] h-[400px] rounded-full bg-purple-muted/20 blur-[100px]"></div>
  </div>

  <!-- Main Content: asymmetric split -->
  <div class="relative z-10 flex-1 flex items-center pt-40 sm:pt-44 pb-16 sm:pb-20">
    <div class="w-full max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_42%] gap-12 lg:gap-8 items-center">

        <!-- LEFT: Typography Block -->
        <div class="flex flex-col justify-center">

          <!-- Eyebrow tag -->
          <div class="animate-fade-in-up inline-flex items-center gap-3 mb-6 sm:mb-8 self-start">
            <span class="w-8 h-px bg-purple-brand"></span>
            <span class="text-[10px] sm:text-xs uppercase tracking-[0.35em] font-bold text-purple-brand font-sans">
              Pulpería Ambulante · Desde 1975
            </span>
          </div>

          <!-- Giant display headline -->
          <h1 class="animate-fade-in-up-d1 font-display font-bold uppercase tracking-tight leading-[0.95] mb-6 sm:mb-8 text-anthracite" style="font-size: clamp(3.2rem, 8.5vw, 7.5rem)">
            Tradición<br />
            <em class="not-italic text-purple-brand font-serif font-normal" style="font-size: clamp(2.8rem, 7vw, 6.5rem)">gallega</em><br />
            que une
          </h1>

          <!-- Obligatory 50-year quote -->
          <p class="animate-fade-in-up-d2 font-sans text-base sm:text-lg text-anthracite-muted font-light leading-relaxed max-w-xl mb-10 sm:mb-12">
            {businessInfo.historyQuote}
          </p>

          <!-- CTA -->
          <div class="animate-fade-in-up-d3 flex flex-wrap items-center gap-5 sm:gap-6">
            <a
              href={`https://wa.me/${businessInfo.phoneClean}?text=${encodeURIComponent(businessInfo.whatsappMessage)}`}
              target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-8 sm:px-10 py-4 sm:py-5 rounded-full bg-purple-brand hover:bg-purple-dark text-white text-sm font-bold uppercase tracking-[0.14em] transition-all duration-300 shadow-purple-glow hover:shadow-purple-tint hover:scale-105 active:scale-95 font-sans"
            >
              <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span>Pedir Presupuesto</span>
            </a>
            <a href={`tel:${businessInfo.phoneClean}`} class="text-sm font-semibold text-anthracite-muted hover:text-purple-brand transition-colors font-sans whitespace-nowrap">
              {businessInfo.phone}
            </a>
          </div>

          <!-- Year stat strip -->
          <div class="animate-fade-in-up-d4 mt-12 sm:mt-16 pt-8 border-t border-linen-border flex items-center gap-8 sm:gap-12">
            <div>
              <p class="font-display text-4xl sm:text-5xl font-bold text-anthracite">50+</p>
              <p class="text-xs uppercase tracking-widest text-anthracite-subtle mt-1 font-sans">Años de oficio</p>
            </div>
            <div class="w-px h-12 bg-linen-border"></div>
            <div>
              <p class="font-display text-4xl sm:text-5xl font-bold text-anthracite">∞</p>
              <p class="text-xs uppercase tracking-widest text-anthracite-subtle mt-1 font-sans">Eventos al año</p>
            </div>
            <div class="w-px h-12 bg-linen-border"></div>
            <div>
              <p class="font-sans text-xs sm:text-sm text-anthracite-muted leading-relaxed max-w-[180px] font-light">
                {businessInfo.coverageText}
              </p>
            </div>
          </div>

        </div>

        <!-- RIGHT: Floating Hero Image -->
        <div class="relative hidden lg:flex items-center justify-center">

          <!-- Decorative ring -->
          <div class="absolute inset-0 rounded-[40px] border border-purple-muted/50 rotate-3 scale-95 pointer-events-none"></div>

          <!-- Image frame -->
          <div class="relative w-full rounded-[32px] overflow-hidden shadow-floating-dark animate-float-slow group" style="aspect-ratio: 3/4;">
            <Image
              src={heroImg}
              alt="Pulpeiro cortando pulpo á feira en directo sobre plato de madera"
              class="w-full h-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-110"
              width={640}
              height={850}
              loading="eager"
            />
            <!-- Subtle overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-anthracite/50 via-transparent to-transparent"></div>

            <!-- Floating badge -->
            <div class="absolute bottom-6 left-6 right-6 flex items-center gap-4 bg-white/15 backdrop-blur-xl border border-white/25 rounded-2xl px-5 py-4">
              <div class="w-10 h-10 rounded-full bg-purple-brand/90 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 fill-none stroke-white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                  <circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/>
                  <path d="M20 4L8.12 15.88M14.47 14.48L20 20M8.12 8.12L12 12"/>
                </svg>
              </div>
              <div>
                <p class="text-[10px] uppercase tracking-[0.2em] text-white/70 font-bold font-sans">Servicio en directo</p>
                <p class="font-serif text-sm font-semibold text-white">Corte a tijera · Plato de madera</p>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>

  <!-- Kinetic Marquee Ticker -->
  <div class="relative z-10 w-full overflow-hidden border-y border-linen-border bg-anthracite py-4">
    <div class="flex animate-marquee whitespace-nowrap select-none" aria-hidden="true">
      {Array(6).fill(null).map(() => (
        <span class="inline-flex items-center gap-6 px-6">
          <span class="font-display text-sm font-bold uppercase tracking-[0.2em] text-white/80">Bodas</span>
          <span class="text-purple-brand text-lg">✦</span>
          <span class="font-display text-sm font-bold uppercase tracking-[0.2em] text-white/80">Ferias</span>
          <span class="text-purple-brand text-lg">✦</span>
          <span class="font-display text-sm font-bold uppercase tracking-[0.2em] text-white/80">Romerías</span>
          <span class="text-purple-brand text-lg">✦</span>
          <span class="font-display text-sm font-bold uppercase tracking-[0.2em] text-white/80">Bautizos</span>
          <span class="text-purple-brand text-lg">✦</span>
          <span class="font-display text-sm font-bold uppercase tracking-[0.2em] text-white/80">Comuniones</span>
          <span class="text-purple-brand text-lg">✦</span>
          <span class="font-display text-sm font-bold uppercase tracking-[0.2em] text-white/80">Catering</span>
          <span class="text-purple-brand text-lg">✦</span>
        </span>
      ))}
    </div>
  </div>

</section>
