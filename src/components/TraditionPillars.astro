---
import { businessInfo } from '../data/businessInfo';
---

<section id="oficio" class="py-20 bg-linen border-b border-linen-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-linen-300">
      {businessInfo.pillars.map((pillar, index) => (
        <div class={`flex flex-col justify-between ${index !== 0 ? 'pt-8 md:pt-0 md:pl-8' : ''}`}>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-serif italic text-2xl font-bold text-purple-brand">
                {pillar.number}
              </span>
              <span class="w-2 h-2 rounded-full bg-purple-brand"></span>
            </div>
            
            <h3 class="font-serif text-xl font-bold text-anthracite mb-2">
              {pillar.title}
            </h3>
            
            <p class="font-sans text-xs sm:text-sm text-anthracite-600 font-normal leading-relaxed">
              {pillar.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
