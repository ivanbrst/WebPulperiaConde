---
import { Image } from 'astro:assets';
import { businessInfo } from '../data/businessInfo';
import logoImg from '../assets/Logo.webp';
---

<header class="fixed top-0 left-0 w-full z-50 bg-slate-dark/95 backdrop-blur-md border-b border-slate-border/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
    <div class="flex justify-between items-center h-24 sm:h-28">
      
      <!-- LOGO CON BUENA PRESENCIA -->
      <a href="/" class="flex-shrink-0 flex items-center py-2 group" aria-label="Inicio">
        <Image 
          src={logoImg} 
          alt={`Logo de ${businessInfo.name}`} 
          class="h-14 sm:h-18 md:h-20 w-auto object-contain brightness-110 contrast-105 transition-transform duration-300 group-hover:scale-105"
          width={280}
          height={80}
          loading="eager"
        />
      </a>

      <!-- Enlaces discretos en serif pequeña -->
      <nav class="hidden lg:flex items-center space-x-10">
        <a href="#inicio" class="font-serif text-xs uppercase tracking-[0.25em] font-semibold text-slate-muted hover:text-gold transition-colors duration-200">
          Inicio
        </a>
        <a href="#servicios" class="font-serif text-xs uppercase tracking-[0.25em] font-semibold text-slate-muted hover:text-gold transition-colors duration-200">
          Servicios
        </a>
        <a href="#nosotros" class="font-serif text-xs uppercase tracking-[0.25em] font-semibold text-slate-muted hover:text-gold transition-colors duration-200">
          Nosotros
        </a>
        <a href="#galeria" class="font-serif text-xs uppercase tracking-[0.25em] font-semibold text-slate-muted hover:text-gold transition-colors duration-200">
          Galería
        </a>
        <a href="#contacto" class="font-serif text-xs uppercase tracking-[0.25em] font-semibold text-slate-muted hover:text-gold transition-colors duration-200">
          Contacto
        </a>
      </nav>

      <!-- Botón CTA destacado en dorado sólido con texto oscuro -->
      <div class="flex items-center gap-4">
        <a 
          href={`https://wa.me/${businessInfo.phoneClean}?text=${encodeURIComponent(businessInfo.whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 sm:px-8 py-3.5 sm:py-4 rounded-full text-xs font-bold tracking-[0.18em] uppercase text-slate-950 bg-gold hover:bg-gold-hover transition-all duration-300 shadow-gold-glow hover:scale-105 active:scale-95 font-sans"
        >
          Pedir Presupuesto
        </a>
      </div>

    </div>
  </div>
</header>
