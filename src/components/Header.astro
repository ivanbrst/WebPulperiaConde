---
import { Image } from 'astro:assets';
import { businessInfo } from '../data/businessInfo';
import logoImg from '../assets/Logo.webp';
---

<header class="fixed top-0 left-0 w-full z-50 transition-all duration-300">
  <div class="mx-4 sm:mx-6 lg:mx-10 mt-3 sm:mt-4">
    <div class="flex justify-between items-center px-5 sm:px-8 py-3 rounded-2xl bg-white/70 backdrop-blur-xl border border-linen-border/80 shadow-glass">

      <!-- LOGO GIGANTE E IMPONENTE -->
      <a href="#inicio" aria-label="Inicio - Pulpería Conde" class="group flex items-center">
        <Image
          src={logoImg}
          alt="Logo Pulpería Conde"
          class="h-16 sm:h-20 md:h-24 w-auto object-contain transition-transform duration-500 group-hover:scale-105"
          width={300}
          height={96}
          loading="eager"
        />
      </a>

      <!-- Nav links — hidden on mobile -->
      <nav class="hidden lg:flex items-center gap-9">
        {[
          { label: 'Servicios', href: '#servicios' },
          { label: 'Nosotros',  href: '#nosotros'  },
          { label: 'Galería',   href: '#galeria'   },
          { label: 'Contacto',  href: '#formulario'},
        ].map(({ label, href }) => (
          <a
            href={href}
            class="relative text-xs uppercase tracking-[0.22em] font-bold text-anthracite-muted hover:text-anthracite transition-colors duration-200 after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-purple-brand after:transition-all after:duration-300 hover:after:w-full font-sans"
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- CTA Button -->
      <a
        href={`https://wa.me/${businessInfo.phoneClean}?text=${encodeURIComponent(businessInfo.whatsappMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-5 sm:px-7 py-3 sm:py-3.5 rounded-full bg-purple-brand hover:bg-purple-dark text-white text-xs font-bold uppercase tracking-[0.14em] transition-all duration-300 shadow-purple-glow hover:shadow-purple-tint hover:scale-105 active:scale-95 font-sans"
      >
        <span class="hidden sm:inline">Pedir Presupuesto</span>
        <span class="sm:hidden">WhatsApp</span>
      </a>

    </div>
  </div>
</header>
