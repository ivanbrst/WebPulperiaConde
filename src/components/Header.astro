---
import { Image } from 'astro:assets';
import { businessInfo } from '../data/businessInfo';
import logoImg from '../assets/Logo.webp';
---

<header class="fixed top-0 left-0 w-full z-50 bg-linen/95 backdrop-blur-md border-b border-linen-300 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
    <div class="flex justify-between items-center h-28 sm:h-36">
      
      <!-- LOGO CON PRESENCIA MASIVA E IMPONENTE -->
      <a href="/" class="flex-shrink-0 flex items-center py-2 group" aria-label="Inicio">
        <Image 
          src={logoImg} 
          alt={`Logo oficial de ${businessInfo.name}`} 
          class="h-20 sm:h-24 md:h-28 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          width={320}
          height={112}
          loading="eager"
        />
      </a>

      <!-- Minimal Navigation -->
      <nav class="hidden md:flex items-center space-x-12">
        <a href="#servicios" class="text-xs uppercase tracking-[0.2em] font-bold text-anthracite-700 hover:text-purple-brand transition-colors">
          Servicios
        </a>
        <a href="#oficio" class="text-xs uppercase tracking-[0.2em] font-bold text-anthracite-700 hover:text-purple-brand transition-colors">
          50 Años de Oficio
        </a>
        <a href="#galeria" class="text-xs uppercase tracking-[0.2em] font-bold text-anthracite-700 hover:text-purple-brand transition-colors">
          Galería
        </a>
      </nav>

      <!-- Vibrant Purple CTA Button -->
      <div class="flex items-center gap-4">
        <a 
          href="#contacto" 
          class="inline-flex items-center justify-center px-6 sm:px-8 py-3.5 sm:py-4 rounded-full text-xs sm:text-sm font-bold tracking-[0.15em] uppercase text-white bg-purple-brand hover:bg-purple-hover transition-all duration-300 shadow-md hover:shadow-purple-glow hover:-translate-y-0.5 active:translate-y-0"
        >
          Pedir Presupuesto
        </a>
      </div>

    </div>
  </div>
</header>
