---
import { businessInfo } from '../data/businessInfo';
---

<section id="formulario" class="py-24 sm:py-32 bg-linen-warm relative overflow-hidden">

  <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-purple-subtle/60 blur-[100px] pointer-events-none"></div>

  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-16 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-20 items-start">

      <!-- Left: Heading & info -->
      <div>
        <span class="inline-flex items-center gap-3 text-[10px] sm:text-xs uppercase tracking-[0.35em] font-bold text-purple-brand mb-6 font-sans">
          <span class="w-8 h-px bg-purple-brand"></span>
          Formulario de Contacto
        </span>
        <h2 class="font-display font-bold uppercase leading-[0.92] text-anthracite mb-6" style="font-size: clamp(2.2rem,5vw,4.5rem)">
          Cuéntanos<br />
          tu <em class="not-italic text-purple-brand font-serif font-normal">evento</em>
        </h2>
        <p class="font-sans text-base text-anthracite-muted font-light leading-relaxed mb-10 max-w-md">
          Rellena el formulario y te responderemos en menos de 24 horas con un presupuesto sin compromiso adaptado a tu celebración.
        </p>

        <div class="space-y-4">
          <a href={`tel:${businessInfo.phoneClean}`} class="flex items-center gap-4 group">
            <div class="w-10 h-10 rounded-xl bg-purple-brand/10 border border-purple-brand/25 flex items-center justify-center text-purple-brand group-hover:bg-purple-brand group-hover:text-white transition-all duration-300 flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <p class="text-[9px] uppercase tracking-widest text-anthracite-subtle font-bold font-sans">Teléfono directo</p>
              <p class="font-display text-base font-bold text-anthracite group-hover:text-purple-brand transition-colors">{businessInfo.phone}</p>
            </div>
          </a>

          <a href={`mailto:${businessInfo.email}`} class="flex items-center gap-4 group">
            <div class="w-10 h-10 rounded-xl bg-purple-brand/10 border border-purple-brand/25 flex items-center justify-center text-purple-brand group-hover:bg-purple-brand group-hover:text-white transition-all duration-300 flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-[9px] uppercase tracking-widest text-anthracite-subtle font-bold font-sans">Correo electrónico</p>
              <p class="font-sans text-sm font-semibold text-anthracite group-hover:text-purple-brand transition-colors">{businessInfo.email}</p>
            </div>
          </a>

          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-purple-brand/10 border border-purple-brand/25 flex items-center justify-center text-purple-brand flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-[9px] uppercase tracking-widest text-anthracite-subtle font-bold font-sans">Horario de atención</p>
              <p class="font-sans text-sm font-medium text-anthracite-muted">{businessInfo.schedule}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="bg-white rounded-3xl border border-linen-border shadow-glass p-8 sm:p-10">
        <form class="flex flex-col gap-6">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="flex flex-col gap-2">
              <label for="nombre" class="text-[10px] uppercase tracking-[0.22em] font-bold text-anthracite-subtle font-sans">Nombre *</label>
              <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre"
                class="w-full bg-transparent border-b-2 border-linen-border focus:border-purple-brand outline-none py-3 font-sans text-sm text-anthracite placeholder:text-anthracite-subtle/50 transition-colors duration-300" />
            </div>
            <div class="flex flex-col gap-2">
              <label for="tipo-evento" class="text-[10px] uppercase tracking-[0.22em] font-bold text-anthracite-subtle font-sans">Tipo de evento *</label>
              <select id="tipo-evento" name="tipo-evento" required
                class="w-full bg-transparent border-b-2 border-linen-border focus:border-purple-brand outline-none py-3 font-sans text-sm text-anthracite transition-colors duration-300 cursor-pointer">
                <option value="" disabled selected>Seleccionar...</option>
                <option value="boda">Boda</option>
                <option value="bautizo">Bautizo / Comunión</option>
                <option value="feria">Feria / Romería</option>
                <option value="comida-cena">Comida / Cena privada</option>
                <option value="catering">Catering corporativo</option>
                <option value="otro">Otro evento</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="flex flex-col gap-2">
              <label for="fecha" class="text-[10px] uppercase tracking-[0.22em] font-bold text-anthracite-subtle font-sans">Fecha aproximada</label>
              <input type="date" id="fecha" name="fecha"
                class="w-full bg-transparent border-b-2 border-linen-border focus:border-purple-brand outline-none py-3 font-sans text-sm text-anthracite transition-colors duration-300" />
            </div>
            <div class="flex flex-col gap-2">
              <label for="comensales" class="text-[10px] uppercase tracking-[0.22em] font-bold text-anthracite-subtle font-sans">Nº de comensales</label>
              <input type="number" id="comensales" name="comensales" min="10" placeholder="Ej. 150"
                class="w-full bg-transparent border-b-2 border-linen-border focus:border-purple-brand outline-none py-3 font-sans text-sm text-anthracite placeholder:text-anthracite-subtle/50 transition-colors duration-300" />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="lugar" class="text-[10px] uppercase tracking-[0.22em] font-bold text-anthracite-subtle font-sans">Localidad o recinto</label>
            <input type="text" id="lugar" name="lugar" placeholder="Ej. Finca rural en Ourense"
              class="w-full bg-transparent border-b-2 border-linen-border focus:border-purple-brand outline-none py-3 font-sans text-sm text-anthracite placeholder:text-anthracite-subtle/50 transition-colors duration-300" />
          </div>

          <div class="flex flex-col gap-2">
            <label for="mensaje" class="text-[10px] uppercase tracking-[0.22em] font-bold text-anthracite-subtle font-sans">Mensaje adicional</label>
            <textarea id="mensaje" name="mensaje" rows="3" placeholder="Cuéntanos más detalles sobre tu evento..."
              class="w-full bg-transparent border-b-2 border-linen-border focus:border-purple-brand outline-none py-3 font-sans text-sm text-anthracite placeholder:text-anthracite-subtle/50 transition-colors duration-300 resize-none"></textarea>
          </div>

          <!-- WhatsApp CTA button -->
          <a
            href={`https://wa.me/${businessInfo.phoneClean}?text=${encodeURIComponent(businessInfo.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 w-full inline-flex items-center justify-center gap-3 py-4 rounded-2xl bg-purple-brand hover:bg-purple-dark text-white text-sm font-bold uppercase tracking-[0.14em] transition-all duration-300 shadow-purple-glow hover:scale-[1.02] active:scale-[0.98] font-sans"
          >
            <!-- WhatsApp official icon (Simple Icons) -->
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Enviar consulta por WhatsApp
          </a>

          <p class="text-center text-[10px] text-anthracite-subtle font-sans">
            Al pulsar el botón serás redirigido a WhatsApp con tu consulta lista para enviar.
          </p>

        </form>
      </div>

    </div>
  </div>
</section>
