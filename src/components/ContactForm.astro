---
import { businessInfo } from '../data/businessInfo';
---

<section id="contacto" class="py-24 sm:py-36 bg-linen relative overflow-hidden">
  
  <!-- Subtle ambient background glow -->
  <div class="absolute right-0 bottom-0 w-96 h-96 bg-purple-brand/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
      
      <!-- Left Column: Direct Concierge & Contact Block -->
      <div class="lg:col-span-5">
        
        <span class="text-xs uppercase tracking-[0.35em] font-bold text-purple-brand block mb-4 font-sans">
          Reserva & Disponibilidad
        </span>
        
        <h2 class="font-serif text-4xl sm:text-6xl font-bold text-anthracite tracking-tight leading-[1.08] mb-8">
          Hablemos de tu celebración.
        </h2>
        
        <p class="font-sans text-base sm:text-lg text-anthracite-600 font-light leading-relaxed mb-12">
          Atendemos personalmente cada solicitud. Indícanos la fecha, el concello o pazo y el número estimado de invitados para coordinar la disponibilidad del puesto.
        </p>

        <!-- Direct WhatsApp Concierge Card with Glassmorphism -->
        <div class="bg-white/90 backdrop-blur-xl rounded-3xl p-8 sm:p-10 border border-linen-300 shadow-floating space-y-8">
          <div>
            <span class="text-xs uppercase tracking-[0.25em] font-bold text-purple-brand block mb-2 font-sans">
              Respuesta en el Día
            </span>
            <h3 class="font-serif text-2xl font-bold text-anthracite">
              Canal Directo por WhatsApp
            </h3>
            <p class="text-sm text-anthracite-600 font-sans mt-2 font-light">
              Envíanos un mensaje directo para resolver cualquier duda o bloquear tu fecha:
            </p>
          </div>

          <a 
            href={`https://wa.me/${businessInfo.phoneClean}?text=${encodeURIComponent(businessInfo.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-3.5 px-8 py-4 sm:py-5 bg-purple-brand hover:bg-purple-hover text-white rounded-full font-bold text-sm uppercase tracking-[0.14em] transition-all duration-300 shadow-purple-glow hover:shadow-purple-tint hover:scale-105 active:scale-95 focus:outline-none focus:ring-4 focus:ring-purple-brand/25 font-sans group"
          >
            <svg class="w-5 h-5 fill-current flex-shrink-0 group-hover:scale-110 transition-transform duration-300" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Abrir chat de WhatsApp
          </a>

          <!-- Details -->
          <div class="border-t border-linen-200 pt-6 space-y-3 text-xs text-anthracite-600 font-sans">
            <p><strong class="text-anthracite-900 font-semibold">Teléfono:</strong> {businessInfo.phone}</p>
            <p><strong class="text-anthracite-900 font-semibold">Email:</strong> {businessInfo.email}</p>
            <p><strong class="text-anthracite-900 font-semibold">Horario:</strong> {businessInfo.schedule}</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Editorial Concierge Form (Underline Only) -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl p-8 sm:p-14 border border-linen-300 shadow-floating hover:shadow-purple-tint transition-all duration-700">
          
          <h3 class="font-serif text-2xl sm:text-4xl font-bold text-anthracite mb-3">
            Formulario de Contacto
          </h3>
          
          <p class="text-sm sm:text-base text-anthracite-600 font-sans mb-12 font-light">
            Déjanos los detalles y te responderemos con una propuesta personalizada.
          </p>

          <form 
            class="space-y-10 font-sans" 
            onsubmit="event.preventDefault(); alert('Gracias por contactar con Pulpería Conde. Responderemos a tu solicitud a la mayor brevedad.');"
          >
            <div>
              <label for="name" class="block text-xs uppercase tracking-[0.2em] font-bold text-anthracite-500 mb-2">
                Nombre o Empresa *
              </label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                placeholder="Ej. Carmen Rodríguez" 
                class="w-full bg-transparent border-b-2 border-linen-300 focus:border-purple-brand py-3 text-anthracite placeholder-anthracite-400 focus:outline-none text-base transition-all duration-300 rounded-none focus:translate-x-1"
                required
              />
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
              <div>
                <label for="phone" class="block text-xs uppercase tracking-[0.2em] font-bold text-anthracite-500 mb-2">
                  Teléfono de Contacto *
                </label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  placeholder="Ej. 625 44 99 20" 
                  class="w-full bg-transparent border-b-2 border-linen-300 focus:border-purple-brand py-3 text-anthracite placeholder-anthracite-400 focus:outline-none text-base transition-all duration-300 rounded-none focus:translate-x-1"
                  required
                />
              </div>
              <div>
                <label for="date" class="block text-xs uppercase tracking-[0.2em] font-bold text-anthracite-500 mb-2">
                  Fecha estimada
                </label>
                <input 
                  type="date" 
                  id="date" 
                  name="date" 
                  class="w-full bg-transparent border-b-2 border-linen-300 focus:border-purple-brand py-3 text-anthracite placeholder-anthracite-400 focus:outline-none text-base transition-all duration-300 rounded-none focus:translate-x-1"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
              <div>
                <label for="type" class="block text-xs uppercase tracking-[0.2em] font-bold text-anthracite-500 mb-2">
                  Tipo de celebración
                </label>
                <select 
                  id="type" 
                  name="type" 
                  class="w-full bg-transparent border-b-2 border-linen-300 focus:border-purple-brand py-3 text-anthracite focus:outline-none text-base transition-all duration-300 rounded-none focus:translate-x-1"
                >
                  <option>Boda o Banquete</option>
                  <option>Fiesta Patronal / Romería</option>
                  <option>Evento de Empresa</option>
                  <option>Celebración Privada / Familiar</option>
                  <option>Otro</option>
                </select>
              </div>
              <div>
                <label for="guests" class="block text-xs uppercase tracking-[0.2em] font-bold text-anthracite-500 mb-2">
                  Nº aprox. de comensales
                </label>
                <input 
                  type="number" 
                  id="guests" 
                  name="guests" 
                  min="15" 
                  placeholder="Ej. 80" 
                  class="w-full bg-transparent border-b-2 border-linen-300 focus:border-purple-brand py-3 text-anthracite placeholder-anthracite-400 focus:outline-none text-base transition-all duration-300 rounded-none focus:translate-x-1"
                />
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs uppercase tracking-[0.2em] font-bold text-anthracite-500 mb-2">
                Concello, pazo o requerimientos específicos
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="2" 
                placeholder="Indica la ubicación o cualquier detalle que debamos tener en cuenta..." 
                class="w-full bg-transparent border-b-2 border-linen-300 focus:border-purple-brand py-3 text-anthracite placeholder-anthracite-400 focus:outline-none text-base transition-all duration-300 rounded-none resize-none focus:translate-x-1"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full py-5 px-8 bg-purple-brand hover:bg-purple-hover text-white rounded-full font-bold text-sm uppercase tracking-[0.15em] transition-all duration-300 shadow-purple-glow hover:shadow-purple-tint hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-4 focus:ring-purple-brand/25"
            >
              Enviar Solicitud de Presupuesto
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>
