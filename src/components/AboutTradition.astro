---
import { Image } from 'astro:assets';
import { businessInfo } from '../data/businessInfo';
import puestoImg from '../assets/Pulperia-conde-O-carballino-Ourense-1-1024x751.webp';
---

<section id="nosotros" class="py-24 sm:py-36 bg-anthracite text-white relative overflow-hidden">

  <!-- Ambient glow -->
  <div class="absolute -left-40 top-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-purple-brand/10 blur-[140px] pointer-events-none"></div>

  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-16 relative z-10">

    <!-- Top eyebrow -->
    <div class="inline-flex items-center gap-3 mb-12 sm:mb-16">
      <span class="w-8 h-px bg-purple-brand"></span>
      <span class="text-[10px] sm:text-xs uppercase tracking-[0.35em] font-bold text-purple-brand font-sans">Nuestra Historia</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-20 items-center">

      <!-- Left: Cinematic image with decorative offset frame -->
      <div class="relative order-2 lg:order-1">

        <!-- Offset decorative border -->
        <div class="absolute -top-4 -left-4 w-full h-full border border-purple-brand/30 rounded-3xl pointer-events-none"></div>

        <div class="relative rounded-3xl overflow-hidden shadow-floating-dark group">
          <Image
            src={puestoImg}
            alt="Equipo de Pulpería Conde en servicio de evento"
            class="w-full aspect-[4/3] object-cover transition-transform duration-[1400ms] ease-[cubic-bezier(.16,1,.3,1)] group-hover:scale-108"
            width={720} height={540}
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-anthracite/70 to-transparent"></div>
        </div>

        <!-- Pillar cards below image (remaining 2) -->
        <div class="grid grid-cols-2 gap-4 mt-4">
          {(businessInfo.pillars ?? []).slice(2, 4).map(p => (
            <div class="rounded-2xl bg-white/5 border border-white/10 p-5 hover:border-purple-brand/40 hover:-translate-y-0.5 transition-all duration-300">
              <span class="font-display text-2xl font-bold text-purple-brand/30 select-none block mb-1">{p.number}</span>
              <h4 class="font-sans text-sm font-bold text-white mb-1">{p.title}</h4>
              <p class="font-sans text-xs text-white/50 leading-relaxed">{p.desc}</p>
            </div>
          ))}
        </div>

      </div>

      <!-- Right: Story block -->
      <div class="order-1 lg:order-2 flex flex-col justify-center">

        <h2 class="font-display font-bold uppercase leading-[0.92] text-white mb-8" style="font-size: clamp(2.8rem,6vw,5.5rem)">
          Más de <em class="not-italic text-purple-brand font-serif font-normal">50 años</em><br />de pasión
        </h2>

        <p class="font-sans text-base sm:text-lg text-white/60 font-light leading-relaxed mb-6 max-w-lg">
          {businessInfo.historyQuote}
        </p>

        <p class="font-sans text-sm sm:text-base text-white/40 font-light leading-relaxed mb-10 max-w-lg">
          Cuidamos cada detalle: el punto exacto de cocción, el corte a tijera en directo frente a los comensales y el aderezo con aceite de oliva virgen extra, flor de sal y pimentón selecto sobre platos auténticos de madera.
        </p>

        <!-- Cursive signature -->
        <div class="pt-8 border-t border-white/10">
          <p class="font-serif text-2xl sm:text-3xl italic text-purple-brand/80 leading-snug">
            "Calidad, Tradición y Cercanía"
          </p>
          <p class="font-sans text-[10px] uppercase tracking-[0.3em] text-white/30 mt-2 font-semibold">
            — Familia Pulpería Conde
          </p>
        </div>

      </div>

    </div>
  </div>
</section>
