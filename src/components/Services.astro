---
import { Image } from 'astro:assets';
import { businessInfo } from '../data/businessInfo';
import img1 from '../assets/Pulperia-Conde-O-Carballino-Ourense-2.webp';

const services = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M3 10h18M5 10l2-6h10l2 6M6 10v11M18 10v11M10 21v-7a2 2 0 014 0v7"/>`,
    title: "Ferias & Romerías",
    desc: "Puesto tradicional en las mejores ferias y romerías de Galicia."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>`,
    title: "Bodas",
    desc: "El toque gallego inolvidable para el cóctel y aperitivo de tu gran día."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>`,
    title: "Bautizos & Comuniones",
    desc: "Celebraciones familiares únicas con sabor auténtico y cercano."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V3m0 5h6.5A1.5 1.5 0 0120 9.5v0a4.5 4.5 0 01-4.5 4.5H12m0-6H5.5A1.5 1.5 0 004 9.5v0A4.5 4.5 0 008.5 14H12m-6 7h12"/>`,
    title: "Comidas & Cenas",
    desc: "Eventos privados, reuniones de empresa y comidas de amigos."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 17h18M4 17a8 8 0 1116 0H4zM12 5V3"/>`,
    title: "Catering",
    desc: "Servicio integral autónomo adaptado a fincas, pazos y cualquier espacio."
  },
];
---

<section id="servicios" class="py-24 sm:py-32 bg-linen-warm relative overflow-hidden">

  <!-- Ambient blob -->
  <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-purple-subtle/40 blur-[120px] pointer-events-none"></div>

  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-16 relative z-10">

    <!-- Header -->
    <div class="mb-16 sm:mb-20 max-w-2xl">
      <span class="inline-flex items-center gap-3 text-[10px] sm:text-xs uppercase tracking-[0.35em] font-bold text-purple-brand mb-5 font-sans">
        <span class="w-8 h-px bg-purple-brand"></span>
        Servicios
      </span>
      <h2 class="font-display font-bold uppercase leading-[0.95] text-anthracite" style="font-size: clamp(2.5rem,6vw,5.5rem)">
        Nos adaptamos<br />
        <em class="not-italic text-purple-brand font-serif font-normal" style="font-size: clamp(2.2rem,5vw,5rem)">a tu evento</em>
      </h2>
    </div>

    <!-- Content: photo left + services right -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-stretch">

      <!-- LEFT: Photo -->
      <div class="relative rounded-3xl overflow-hidden shadow-floating-dark group bg-anthracite">
        <Image
          src={img1}
          alt="Pulpería Conde en servicio de evento"
          class="w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105"
          style="min-height: 400px;"
          width={720} height={820}
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-anthracite/80 via-anthracite/20 to-transparent"></div>
        <!-- Quote overlay -->
        <div class="absolute bottom-0 left-0 right-0 p-8">
          <p class="font-serif text-lg sm:text-xl italic text-white/90 leading-relaxed">
            "Más de 50 años llevando el auténtico pulpo á feira a tu celebración"
          </p>
          <div class="flex flex-wrap gap-2 mt-4">
            {['Ferias', 'Bodas', 'Comuniones', 'Catering'].map(tag => (
              <span class="px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-[10px] font-bold uppercase tracking-wider text-white/80 font-sans">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- RIGHT: Service list -->
      <div class="flex flex-col gap-3">
        {services.map((s, i) => (
          <div class="group flex items-start gap-5 bg-white rounded-2xl border border-linen-border px-6 py-5 shadow-glass hover:border-purple-brand/30 hover:shadow-purple-tint hover:-translate-y-0.5 transition-all duration-300 cursor-default">
            <!-- Icon -->
            <div class="w-10 h-10 rounded-xl bg-purple-subtle border border-purple-muted/60 flex items-center justify-center text-purple-brand flex-shrink-0 group-hover:bg-purple-brand group-hover:text-white group-hover:border-purple-brand transition-all duration-300 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" set:html={s.icon}></svg>
            </div>
            <!-- Text -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-display text-base font-bold text-anthracite uppercase tracking-wide">{s.title}</h3>
                <span class="text-[10px] font-bold text-purple-brand/40 font-sans flex-shrink-0 group-hover:text-purple-brand transition-colors">0{i + 1}</span>
              </div>
              <p class="font-sans text-sm text-anthracite-muted font-light mt-1 leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
