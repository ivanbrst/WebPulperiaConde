---
import { businessInfo } from '../data/businessInfo';
---

<section id="servicios" class="py-24 sm:py-32 bg-cream text-cream-text relative overflow-hidden">
  
  <!-- Marca de agua sutil de silueta del pulpo en baja opacidad -->
  <div class="absolute -right-20 top-10 w-96 h-96 opacity-[0.03] pointer-events-none select-none text-slate-dark">
    <svg viewBox="0 0 24 24" class="w-full h-full fill-current">
      <path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.16-.08.31-.17.47-.26.87-.51 1.4-1.46 1.4-2.47v-.5c0-.83.67-1.5 1.5-1.5h.5c.83 0 1.5-.67 1.5-1.5v-1c0-.83.67-1.5 1.5-1.5h1c.83 0 1.5-.67 1.5-1.5v-1.27c1.78-.62 3.29-1.92 4.09-3.63C21.91 8.87 20.31 4 15.5 3 14.34 2.36 13.18 2 12 2z"/>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 relative z-10">
    
    <!-- Encabezado centrado con separador decorativo -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <span class="text-xs uppercase tracking-[0.35em] font-bold text-gold-dark block mb-3 font-sans">
        Nuestros Servicios
      </span>
      
      <h2 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-slate-dark uppercase mb-5">
        Nos Adaptamos a tu Evento
      </h2>
      
      <!-- Separador decorativo tradicional -->
      <div class="flex items-center justify-center gap-4 text-gold">
        <span class="w-16 h-px bg-gold/50"></span>
        <span class="font-serif text-lg">✦</span>
        <span class="w-16 h-px bg-gold/50"></span>
      </div>
    </div>

    <!-- Cuadrícula horizontal de 5 servicios -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6">
      
      <!-- 1. Ferias -->
      <div class="bg-white rounded-2xl p-8 border border-cream-border shadow-card-soft hover:shadow-gold-subtle hover:-translate-y-1.5 transition-all duration-300 text-center flex flex-col items-center justify-between group">
        <div>
          <div class="w-16 h-16 rounded-full bg-cream-dark border border-gold/40 flex items-center justify-center text-gold mb-6 group-hover:bg-gold group-hover:text-slate-950 transition-all duration-300">
            <!-- Icono Puesto / Carpa -->
            <svg class="w-7 h-7 stroke-current" fill="none" stroke-width="1.6" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M3 10h18M5 10l2-6h10l2 6M6 10v11M18 10v11M10 21v-7a2 2 0 014 0v7" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-slate-dark mb-3">
            Ferias
          </h3>
          <p class="font-sans text-xs sm:text-sm text-cream-muted font-light leading-relaxed">
            Puesto tradicional en las mejores ferias y romerías de toda Galicia.
          </p>
        </div>
        <div class="w-8 h-0.5 bg-gold/30 mt-6 group-hover:w-16 group-hover:bg-gold transition-all duration-300"></div>
      </div>

      <!-- 2. Bodas -->
      <div class="bg-white rounded-2xl p-8 border border-cream-border shadow-card-soft hover:shadow-gold-subtle hover:-translate-y-1.5 transition-all duration-300 text-center flex flex-col items-center justify-between group">
        <div>
          <div class="w-16 h-16 rounded-full bg-cream-dark border border-gold/40 flex items-center justify-center text-gold mb-6 group-hover:bg-gold group-hover:text-slate-950 transition-all duration-300">
            <!-- Icono Anillos / Boda -->
            <svg class="w-7 h-7 stroke-current" fill="none" stroke-width="1.6" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a6 6 0 100-12 6 6 0 000 12zM16 11a6 6 0 100-12 6 6 0 000 12z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-slate-dark mb-3">
            Bodas
          </h3>
          <p class="font-sans text-xs sm:text-sm text-cream-muted font-light leading-relaxed">
            El toque gallego inolvidable para el cóctel y aperitivo de tu día especial.
          </p>
        </div>
        <div class="w-8 h-0.5 bg-gold/30 mt-6 group-hover:w-16 group-hover:bg-gold transition-all duration-300"></div>
      </div>

      <!-- 3. Bautizos y Comuniones -->
      <div class="bg-white rounded-2xl p-8 border border-cream-border shadow-card-soft hover:shadow-gold-subtle hover:-translate-y-1.5 transition-all duration-300 text-center flex flex-col items-center justify-between group">
        <div>
          <div class="w-16 h-16 rounded-full bg-cream-dark border border-gold/40 flex items-center justify-center text-gold mb-6 group-hover:bg-gold group-hover:text-slate-950 transition-all duration-300">
            <!-- Icono Familia / Comunión -->
            <svg class="w-7 h-7 stroke-current" fill="none" stroke-width="1.6" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-slate-dark mb-3">
            Bautizos y Comuniones
          </h3>
          <p class="font-sans text-xs sm:text-sm text-cream-muted font-light leading-relaxed">
            Celebraciones familiares únicas con sabor auténtico y cercano.
          </p>
        </div>
        <div class="w-8 h-0.5 bg-gold/30 mt-6 group-hover:w-16 group-hover:bg-gold transition-all duration-300"></div>
      </div>

      <!-- 4. Comidas y Cenas -->
      <div class="bg-white rounded-2xl p-8 border border-cream-border shadow-card-soft hover:shadow-gold-subtle hover:-translate-y-1.5 transition-all duration-300 text-center flex flex-col items-center justify-between group">
        <div>
          <div class="w-16 h-16 rounded-full bg-cream-dark border border-gold/40 flex items-center justify-center text-gold mb-6 group-hover:bg-gold group-hover:text-slate-950 transition-all duration-300">
            <!-- Icono Cena / Copa -->
            <svg class="w-7 h-7 stroke-current" fill="none" stroke-width="1.6" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V3m0 5h6.5A1.5 1.5 0 0120 9.5v0a4.5 4.5 0 01-4.5 4.5H12m0-6H5.5A1.5 1.5 0 004 9.5v0A4.5 4.5 0 008.5 14H12m-6 7h12" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-slate-dark mb-3">
            Comidas y Cenas
          </h3>
          <p class="font-sans text-xs sm:text-sm text-cream-muted font-light leading-relaxed">
            Eventos privados, reuniones de empresa y comidas de amigos.
          </p>
        </div>
        <div class="w-8 h-0.5 bg-gold/30 mt-6 group-hover:w-16 group-hover:bg-gold transition-all duration-300"></div>
      </div>

      <!-- 5. Catering -->
      <div class="bg-white rounded-2xl p-8 border border-cream-border shadow-card-soft hover:shadow-gold-subtle hover:-translate-y-1.5 transition-all duration-300 text-center flex flex-col items-center justify-between group">
        <div>
          <div class="w-16 h-16 rounded-full bg-cream-dark border border-gold/40 flex items-center justify-center text-gold mb-6 group-hover:bg-gold group-hover:text-slate-950 transition-all duration-300">
            <!-- Icono Catering / Bandeja -->
            <svg class="w-7 h-7 stroke-current" fill="none" stroke-width="1.6" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 17h18M4 17a8 8 0 1116 0H4zM12 5V3" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold text-slate-dark mb-3">
            Catering
          </h3>
          <p class="font-sans text-xs sm:text-sm text-cream-muted font-light leading-relaxed">
            Servicio integral autónomo adaptado completamente a tu espacio.
          </p>
        </div>
        <div class="w-8 h-0.5 bg-gold/30 mt-6 group-hover:w-16 group-hover:bg-gold transition-all duration-300"></div>
      </div>

    </div>

  </div>
</section>
