---
import { Image } from 'astro:assets';
import img1 from '../assets/pulpeira-cortando-pulpo.webp';
import img2 from '../assets/Pulperia-Conde-O-Carballino-Ourense-2.webp';
import img3 from '../assets/pulperia-Carballino-1024x1024.webp';
import img4 from '../assets/Pulperia-conde-O-carballino-Ourense-1-1024x751.webp';
import img5 from '../assets/Pulperia-conde-O-carballino-Ourense-6.webp';

const photos = [
  { src: img4, tag: "Bodas",       title: "El día perfecto",       aspect: "aspect-[3/4]", offset: "" },
  { src: img1, tag: "Elaboración", title: "Corte en directo",      aspect: "aspect-[4/5]", offset: "lg:mt-10" },
  { src: img3, tag: "Ferias",      title: "Puesto tradicional",    aspect: "aspect-[3/4]", offset: "lg:-mt-6" },
  { src: img2, tag: "Eventos",     title: "Ambiente único",        aspect: "aspect-[4/5]", offset: "lg:mt-8" },
  { src: img5, tag: "Catering",    title: "Servicio integral",     aspect: "aspect-[3/4]", offset: "lg:-mt-4" },
];
---

<section id="galeria" class="py-24 sm:py-36 bg-linen overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-16">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-14 sm:mb-18">
      <div>
        <span class="inline-flex items-center gap-3 text-[10px] sm:text-xs uppercase tracking-[0.35em] font-bold text-purple-brand mb-5 font-sans">
          <span class="w-8 h-px bg-purple-brand"></span>
          Galería
        </span>
        <h2 class="font-display font-bold uppercase leading-none text-anthracite" style="font-size: clamp(2.5rem,5.5vw,5rem)">
          Nuestros<br />
          <em class="not-italic text-purple-brand font-serif font-normal">momentos</em>
        </h2>
      </div>
    </div>

    <!-- Asymmetric lookbook strip (vertical offsets) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-5 items-start">
      {photos.map(item => (
        <a href="#formulario" class={`group relative rounded-2xl overflow-hidden bg-anthracite shadow-floating block ${item.offset}`}>
          <div class={`relative ${item.aspect} w-full`}>
            <Image
              src={item.src}
              alt={item.title}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
              width={500} height={700}
              loading="lazy"
            />
            <!-- Hover overlay with caption -->
            <div class="absolute inset-0 bg-gradient-to-t from-anthracite/85 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5">
              <span class="text-[9px] uppercase tracking-[0.2em] font-bold text-purple-brand font-sans mb-1">{item.tag}</span>
              <p class="font-serif text-sm font-semibold text-white">{item.title}</p>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
