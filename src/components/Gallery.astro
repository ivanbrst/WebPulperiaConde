---
import { Image } from 'astro:assets';

import img1 from '../assets/pulpeira-cortando-pulpo.webp';
import img2 from '../assets/Pulperia-Conde-O-Carballino-Ourense-2.webp';
import img3 from '../assets/pulperia-Carballino-1024x1024.webp';
import img4 from '../assets/Pulperia-conde-O-carballino-Ourense-1-1024x751.webp';
import img5 from '../assets/Pulperia-conde-O-carballino-Ourense-6.webp';

const photos = [
  { src: img4, title: "Servicio en Bodas y Banquetes", tag: "Bodas" },
  { src: img1, title: "Corte Tradicional en Directo", tag: "Elaboración" },
  { src: img3, title: "Montaje de Puesto en Finca", tag: "Eventos" },
  { src: img2, title: "Ambiente en Ferias Gallegas", tag: "Ferias" },
  { src: img5, title: "Servicio de Catering Integral", tag: "Catering" },
];
---

<section id="galeria" class="py-24 sm:py-32 bg-cream text-cream-text relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
    
    <!-- Encabezado centrado con separador -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs uppercase tracking-[0.35em] font-bold text-gold-dark block mb-3 font-sans">
        Galería
      </span>
      
      <h2 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-slate-dark uppercase mb-5">
        Nuestros Momentos
      </h2>
      
      <div class="flex items-center justify-center gap-4 text-gold">
        <span class="w-16 h-px bg-gold/50"></span>
        <span class="font-serif text-lg">✦</span>
        <span class="w-16 h-px bg-gold/50"></span>
      </div>
    </div>

    <!-- Tira horizontal de 5 fotografías reales con bordes limpios y sutil efecto hover -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
      {photos.map((item) => (
        <div class="group relative rounded-2xl overflow-hidden shadow-card-soft border border-cream-border bg-slate-dark aspect-[4/5] cursor-pointer">
          <Image 
            src={item.src} 
            alt={item.title} 
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
            width={600}
            height={750}
            loading="lazy"
          />

          <!-- Overlay sutil en hover -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5 text-white">
            <span class="text-[10px] uppercase tracking-[0.2em] font-bold text-gold font-sans mb-1">
              {item.tag}
            </span>
            <p class="font-serif text-sm font-bold text-white leading-snug">
              {item.title}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Botón secundario en dorado "VER MÁS" / Enlace a contacto -->
    <div class="text-center mt-14">
      <a 
        href="#contacto" 
        class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full border border-gold text-slate-dark hover:bg-gold hover:text-slate-950 transition-all duration-300 font-bold text-xs uppercase tracking-[0.16em] font-sans shadow-sm hover:scale-105"
      >
        <span>Ver Más & Pedir Presupuesto</span>
        <span class="text-sm">→</span>
      </a>
    </div>

  </div>
</section>
