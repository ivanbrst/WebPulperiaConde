---
import { Image } from 'astro:assets';
import { businessInfo } from '../data/businessInfo';
import logoImg from '../assets/Logo.webp';
---

<footer class="bg-anthracite-950 text-linen-100 pt-20 sm:pt-28 pb-12 border-t border-anthracite-800 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
    
    <!-- Protagonist Giant Logo and Main Info -->
    <div class="flex flex-col items-center text-center pb-16 border-b border-anthracite-800">
      
      <!-- LOGO PROTAGONISTA GIGANTE -->
      <div class="mb-10">
        <Image 
          src={logoImg} 
          alt={`Logo de ${businessInfo.name} en gran formato`} 
          class="h-28 sm:h-36 md:h-44 w-auto object-contain brightness-0 invert opacity-95 hover:opacity-100 transition-opacity"
          width={450}
          height={160}
          loading="lazy"
        />
      </div>
      
      <p class="font-serif text-xl sm:text-2xl text-linen-100 max-w-2xl leading-relaxed mb-4">
        Más de 50 años acercando el auténtico sabor del pulpo a feira a ferias, bodas y eventos en toda Galicia.
      </p>
      
      <p class="text-xs uppercase tracking-[0.25em] font-semibold text-purple-light max-w-md font-sans">
        {businessInfo.coverageText}
      </p>
    </div>

    <!-- Clean Contact Details Block (No Traditional Navigation) -->
    <div class="py-14 border-b border-anthracite-800 grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
      
      <!-- Email -->
      <div class="flex flex-col items-center md:items-start">
        <span class="text-xs uppercase tracking-[0.2em] font-bold text-anthracite-500 font-sans mb-2">
          Correo Electrónico
        </span>
        <a 
          href={`mailto:${businessInfo.email}`} 
          class="font-sans text-base sm:text-lg font-semibold text-linen-100 hover:text-purple-light transition-colors"
        >
          {businessInfo.email}
        </a>
      </div>

      <!-- Teléfono -->
      <div class="flex flex-col items-center md:items-start">
        <span class="text-xs uppercase tracking-[0.2em] font-bold text-anthracite-500 font-sans mb-2">
          Teléfono de Contacto
        </span>
        <a 
          href={`tel:${businessInfo.phoneClean}`} 
          class="font-serif text-xl sm:text-2xl font-bold text-white hover:text-purple-light transition-colors"
        >
          {businessInfo.phone}
        </a>
      </div>

      <!-- Horario de atención -->
      <div class="flex flex-col items-center md:items-start">
        <span class="text-xs uppercase tracking-[0.2em] font-bold text-anthracite-500 font-sans mb-2">
          Horario de Atención
        </span>
        <p class="font-sans text-sm sm:text-base text-linen-200 font-light leading-snug">
          {businessInfo.schedule}
        </p>
      </div>

    </div>

    <!-- Políticas Links (4 links) & Copyright -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-anthracite-400 font-sans">
      
      <p>© {new Date().getFullYear()} {businessInfo.name}. Todos los derechos reservados.</p>
      
      <!-- Bloque de Políticas -->
      <div class="flex flex-wrap items-center justify-center gap-6 text-linen-300 font-medium">
        <span class="text-anthracite-500 uppercase tracking-wider text-[10px]">Políticas:</span>
        <a href="#contacto" class="hover:text-purple-light transition-colors">Privacidad</a>
        <a href="#contacto" class="hover:text-purple-light transition-colors">Cookies</a>
        <a href="#contacto" class="hover:text-purple-light transition-colors">Aviso Legal</a>
        <a href="#contacto" class="hover:text-purple-light transition-colors">Accesibilidad</a>
      </div>

    </div>

  </div>
</footer>
