---
import { Image } from 'astro:assets';
import { businessInfo } from '../data/businessInfo';
import logoImg from '../assets/Logo.webp';
---

<footer id="contacto" class="bg-anthracite text-white relative overflow-hidden">

  <!-- Top CTA strip -->
  <div class="border-b border-white/10">
    <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-16 py-20 sm:py-28 flex flex-col lg:flex-row items-start lg:items-end justify-between gap-10 lg:gap-20">

      <!-- Left: Heading -->
      <div class="flex-1 max-w-2xl">
        <span class="inline-flex items-center gap-3 text-[10px] sm:text-xs uppercase tracking-[0.35em] font-bold text-purple-brand mb-6 font-sans">
          <span class="w-8 h-px bg-purple-brand"></span>
          Contacto Directo
        </span>
        <h2 class="font-display font-bold uppercase leading-[0.92] text-white" style="font-size: clamp(2.5rem,5.5vw,5rem)">
          ¿Organizas<br />
          un evento? <em class="not-italic text-purple-brand font-serif font-normal">Cuenta con nosotros</em>
        </h2>
      </div>

      <!-- Right: Contact info block -->
      <div class="flex-shrink-0 w-full max-w-sm bg-white/5 border border-white/10 rounded-3xl p-8 sm:p-10 flex flex-col gap-6">

        <!-- Phone -->
        <a href={`tel:${businessInfo.phoneClean}`} class="flex items-center gap-4 group">
          <div class="w-11 h-11 rounded-xl bg-purple-brand/15 border border-purple-brand/30 flex items-center justify-center text-purple-brand flex-shrink-0 group-hover:bg-purple-brand group-hover:text-white transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div>
            <p class="text-[9px] uppercase tracking-widest text-white/40 font-bold font-sans">Teléfono</p>
            <p class="font-display text-lg font-bold text-white group-hover:text-purple-brand transition-colors">{businessInfo.phone}</p>
          </div>
        </a>

        <!-- Email -->
        <a href={`mailto:${businessInfo.email}`} class="flex items-center gap-4 group">
          <div class="w-11 h-11 rounded-xl bg-purple-brand/15 border border-purple-brand/30 flex items-center justify-center text-purple-brand flex-shrink-0 group-hover:bg-purple-brand group-hover:text-white transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <p class="text-[9px] uppercase tracking-widest text-white/40 font-bold font-sans">Email</p>
            <p class="font-sans text-sm font-semibold text-white group-hover:text-purple-brand transition-colors break-all">{businessInfo.email}</p>
          </div>
        </a>

        <!-- Coverage -->
        <div class="flex items-center gap-4">
          <div class="w-11 h-11 rounded-xl bg-purple-brand/15 border border-purple-brand/30 flex items-center justify-center text-purple-brand flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-[9px] uppercase tracking-widest text-white/40 font-bold font-sans">Cobertura</p>
            <p class="font-sans text-sm font-medium text-white/80">{businessInfo.coverageText}</p>
          </div>
        </div>

        <!-- Schedule -->
        <div class="flex items-center gap-4">
          <div class="w-11 h-11 rounded-xl bg-purple-brand/15 border border-purple-brand/30 flex items-center justify-center text-purple-brand flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-[9px] uppercase tracking-widest text-white/40 font-bold font-sans">Horario</p>
            <p class="font-sans text-sm font-medium text-white/80">{businessInfo.schedule}</p>
          </div>
        </div>



      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-16 py-10 sm:py-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">

    <!-- Massive logo -->
    <a href="/" aria-label="Inicio">
      <Image
        src={logoImg}
        alt="Logo Pulpería Conde"
        class="h-12 sm:h-16 w-auto object-contain opacity-60 hover:opacity-100 transition-opacity duration-300 brightness-0 invert"
        width={220} height={64}
        loading="lazy"
      />
    </a>

    <!-- Policies -->
    <div class="flex flex-wrap items-center gap-1 text-[10px] text-white/30 font-sans">
      <span class="mr-2">© {new Date().getFullYear()} Pulpería Conde ·</span>
      {['Privacidad', 'Cookies', 'Aviso Legal', 'Accesibilidad'].map((link, i, arr) => (
        <>
          <a href={`#${link.toLowerCase().replace(' ', '-')}`} class="hover:text-purple-brand transition-colors">{link}</a>
          {i < arr.length - 1 && <span class="text-white/15">·</span>}
        </>
      ))}
    </div>

  </div>

</footer>
