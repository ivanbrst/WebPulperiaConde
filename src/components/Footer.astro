---
import { businessInfo } from '../data/businessInfo';
---

<footer id="contacto" class="bg-slate-dark text-white pt-24 pb-12 border-t border-slate-border relative overflow-hidden">
  
  <!-- Marca de agua decorativa sutil de fondo -->
  <div class="absolute right-0 bottom-0 w-96 h-96 opacity-[0.03] pointer-events-none select-none">
    <svg viewBox="0 0 24 24" class="w-full h-full fill-current">
      <path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.16-.08.31-.17.47-.26.87-.51 1.4-1.46 1.4-2.47v-.5c0-.83.67-1.5 1.5-1.5h.5c.83 0 1.5-.67 1.5-1.5v-1c0-.83.67-1.5 1.5-1.5h1c.83 0 1.5-.67 1.5-1.5v-1.27c1.78-.62 3.29-1.92 4.09-3.63C21.91 8.87 20.31 4 15.5 3 14.34 2.36 13.18 2 12 2z"/>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 pb-20 border-b border-slate-border">
      
      <!-- Left Column: ¿Organizas un evento? -->
      <div class="lg:col-span-6 flex flex-col justify-center">
        <span class="text-xs uppercase tracking-[0.35em] font-bold text-gold block mb-4 font-sans">
          Contacto Directo
        </span>
        
        <h2 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-white uppercase mb-6 leading-tight">
          ¿Organizas un evento? <br />
          <span class="text-gold font-normal italic font-cursive lowercase first-letter:uppercase">
            Estaremos encantados de formar parte
          </span>
        </h2>
        
        <p class="font-sans text-base text-slate-muted font-light leading-relaxed mb-8 max-w-lg">
          Cuéntanos los detalles de tu celebración (fecha, concello o finca y número aproximado de comensales) y te prepararemos un presupuesto a medida sin compromiso.
        </p>

        <div>
          <a 
            href={`https://wa.me/${businessInfo.phoneClean}?text=${encodeURIComponent(businessInfo.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3.5 px-9 py-4 sm:py-5 bg-gold hover:bg-gold-hover text-slate-950 rounded-full font-bold text-sm uppercase tracking-[0.16em] transition-all duration-300 shadow-gold-glow hover:scale-105 active:scale-95 font-sans"
          >
            <span>Pedir Presupuesto por WhatsApp</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Bloque de Contacto con iconos dorados -->
      <div class="lg:col-span-6 flex flex-col justify-center bg-slate-card p-8 sm:p-12 rounded-3xl border border-slate-border">
        
        <h3 class="font-serif text-2xl font-bold text-white uppercase mb-8 pb-4 border-b border-slate-border">
          Información de Contacto
        </h3>

        <div class="space-y-6">
          
          <!-- Teléfono -->
          <div class="flex items-start gap-5">
            <div class="w-12 h-12 rounded-xl bg-gold/10 border border-gold/30 flex items-center justify-center text-gold flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs uppercase tracking-widest text-slate-muted font-bold block mb-1">Teléfono de atención</span>
              <a href={`tel:${businessInfo.phoneClean}`} class="font-serif text-xl font-bold text-white hover:text-gold transition-colors">
                {businessInfo.phone}
              </a>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start gap-5">
            <div class="w-12 h-12 rounded-xl bg-gold/10 border border-gold/30 flex items-center justify-center text-gold flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs uppercase tracking-widest text-slate-muted font-bold block mb-1">Correo electrónico</span>
              <a href={`mailto:${businessInfo.email}`} class="font-sans text-base text-white hover:text-gold transition-colors">
                {businessInfo.email}
              </a>
            </div>
          </div>

          <!-- Cobertura -->
          <div class="flex items-start gap-5">
            <div class="w-12 h-12 rounded-xl bg-gold/10 border border-gold/30 flex items-center justify-center text-gold flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs uppercase tracking-widest text-slate-muted font-bold block mb-1">Cobertura</span>
              <p class="font-sans text-sm text-white font-medium">
                {businessInfo.coverageText}
              </p>
            </div>
          </div>

          <!-- Horario -->
          <div class="flex items-start gap-5">
            <div class="w-12 h-12 rounded-xl bg-gold/10 border border-gold/30 flex items-center justify-center text-gold flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs uppercase tracking-widest text-slate-muted font-bold block mb-1">Horario de atención</span>
              <p class="font-sans text-sm text-white font-medium">
                {businessInfo.schedule}
              </p>
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- Barra inferior con Copyright y enlaces de "Políticas" -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-slate-muted font-sans">
      <p>© {new Date().getFullYear()} {businessInfo.name}. Todos los derechos reservados.</p>
      
      <div class="flex flex-wrap items-center justify-center gap-6 text-slate-muted font-medium">
        <span class="text-gold text-[10px] uppercase tracking-wider">Políticas:</span>
        <a href="#contacto" class="hover:text-gold transition-colors">Privacidad</a>
        <a href="#contacto" class="hover:text-gold transition-colors">Cookies</a>
        <a href="#contacto" class="hover:text-gold transition-colors">Aviso Legal</a>
        <a href="#contacto" class="hover:text-gold transition-colors">Accesibilidad</a>
      </div>
    </div>

  </div>
</footer>
