---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomBar from '../components/BottomBar.astro';
import { businessInfo } from '../data/businessInfo';

interface Props {
	title?: string;
	description?: string;
}

const { 
  title = `${businessInfo.name} — ${businessInfo.tagline}`, 
  description = businessInfo.description 
} = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FoodEstablishment",
  "name": businessInfo.name,
  "description": description,
  "telephone": businessInfo.phoneClean,
  "email": businessInfo.email,
  "servesCuisine": "Gallega Tradicional",
  "areaServed": "Galicia y alrededores"
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
    <!-- Google Fonts: Cinzel, Cormorant Garamond, Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- OpenGraph SEO -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />

		<title>{title}</title>
    
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <style is:global>
      /* Luxury Custom Scrollbar */
      ::-webkit-scrollbar {
        width: 7px;
      }
      ::-webkit-scrollbar-track {
        background: #141619;
      }
      ::-webkit-scrollbar-thumb {
        background: #C89D4B;
        border-radius: 9999px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #D4AF37;
      }
    </style>
	</head>
	<body class="bg-slate-dark text-white font-sans antialiased overflow-x-hidden selection:bg-gold selection:text-slate-dark">
    
    <!-- Dark Luxury Header -->
    <Header />

    <!-- Main Page Content -->
    <main>
		  <slot />
    </main>

    <!-- Dark Luxury Footer -->
    <Footer />

    <!-- Fixed Mobile Contact Bar -->
    <BottomBar />

	</body>
</html>
